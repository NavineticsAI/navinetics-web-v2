# The review documents are rebuilt from the manifest on demand and would
# otherwise land in every diff as binary noise. The MANIFEST is committed: it
# is what a returned document has to be matched against.
*.docx
.rendered.json
.selftest*
.watch*
.rt.json
.preview.html
copy-changes.json
.bios*.json

# …except a reviewed document arriving from the shared folder. That one has to
# be committable, because committing it is what triggers the workflow that
# applies it. Without this exception the Power Automate flow pushes a file git
# silently ignores and nothing ever happens.
!incoming/*.docx
