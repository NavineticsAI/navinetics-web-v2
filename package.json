{
  "name": "nn_website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:build": "node tools/check-build.mjs",
    "check:routes": "node tools/check-routes.mjs",
    "check:mobile": "node tools/check-mobile.mjs",
    "check:webkit": "node tools/check-webkit.mjs",
    "check:perf": "node tools/check-perf.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "copy:export": "node tools/copy-export.mjs && python tools/copy-docx.py",
    "copy:import": "python tools/copy-import.py",
    "copy:apply": "node tools/copy-apply.mjs",
    "copy:check": "node tools/copy-coverage.mjs",
    "copy:test": "python tools/copy-selftest.py",
    "copy:watch": "node tools/copy-watch.mjs",
    "build:review": "vite build --mode review",
    "preview:review": "vite build --mode review && vite preview",
    "copy:publish": "node tools/copy-publish.mjs",
