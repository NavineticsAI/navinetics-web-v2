    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "acorn": "^8.18.0",
    "acorn-jsx": "^5.3.2",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0"
